# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/grievance_db

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Gemini AI ----
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ---- OTP provider (placeholder: MSG91 / Twilio) ----
OTP_PROVIDER_API_KEY=
OTP_EXPIRY_MINUTES=5
OTP_MAX_REQUESTS_PER_HOUR=3

# ---- Notification provider (placeholder: Twilio / SendGrid) ----
NOTIFICATION_PROVIDER_API_KEY=

# ---- File storage ----
UPLOAD_DIR=./uploads
S3_BUCKET_NAME=

# ---- App ----
CORS_ORIGINS=http://localhost:5173
MAX_COMPLAINTS_PER_DAY=3
AUTO_BAN_REJECTION_RATE=0.8
ENV=development
